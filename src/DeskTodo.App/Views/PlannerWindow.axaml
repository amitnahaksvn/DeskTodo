<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:conv="using:DeskTodo.App.Converters"
        xmlns:prim="using:Avalonia.Controls.Primitives"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="580"
        x:Class="DeskTodo.App.Views.PlannerWindow"
        x:DataType="vm:PlannerViewModel"
        Title="Planner"
        Width="640" Height="580"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!--
      Phase 21's remaining planner views — Week / Year / Agenda / Timeline / Kanban / Matrix
      — as tabs in one window (see PlannerViewModel's doc comment for why one window rather
      than six). Every tab is a read-only view over the same TaskItem data the grid/calendar
      already read; clicking a day/task anywhere in here navigates the widget there and
      closes this window (see PlannerWindow.axaml.cs).
    -->
    <Grid RowDefinitions="Auto,*" Margin="20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Planner" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1" Content="Close" Command="{Binding CloseCommand}"
                    FontSize="12" Padding="10,4" Background="#3B82F6" Foreground="White" />
        </Grid>

        <TabControl Grid.Row="1">
            <!-- Week -->
            <TabItem Header="Week">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                        <Button Grid.Column="0" Content="&#x2039;" Command="{Binding Week.PreviousWeekCommand}" Padding="10,4" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="{Binding Week.WeekTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="&#x203A;" Command="{Binding Week.NextWeekCommand}" Padding="10,4" FontSize="14" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Today" Command="{Binding Week.GoToCurrentWeekCommand}" FontSize="12" Padding="10,4" />
                    </Grid>
                    <prim:UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="Sun" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Mon" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Tue" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Wed" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Thu" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Fri" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Sat" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </prim:UniformGrid>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Week.Days}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prim:UniformGrid Columns="7" ColumnSpacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                <Button Command="{Binding SelectCommand}" Padding="0" MinHeight="72"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Background="{Binding IsToday, Converter={x:Static conv:BoolToTodayBackgroundConverter.Instance}}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding DayNumber}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CountDisplay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasTasks}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- Year -->
            <TabItem Header="Year">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                        <Button Grid.Column="0" Content="&#x2039;" Command="{Binding Year.PreviousYearCommand}" Padding="10,4" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="{Binding Year.Year}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="&#x203A;" Command="{Binding Year.NextYearCommand}" Padding="10,4" FontSize="14" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Today" Command="{Binding Year.GoToCurrentYearCommand}" FontSize="12" Padding="10,4" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Year.Months}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prim:UniformGrid Columns="3" RowSpacing="6" ColumnSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:YearMonthSummaryViewModel">
                                <Button Command="{Binding SelectCommand}" Padding="0" MinHeight="64"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Background="{Binding IsCurrentMonth, Converter={x:Static conv:BoolToTodayBackgroundConverter.Instance}}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Margin="8" Spacing="2">
                                        <TextBlock Text="{Binding MonthName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CountDisplay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- Agenda -->
            <TabItem Header="Agenda">
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="Nothing coming up in the next two weeks." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               IsVisible="{Binding Agenda.HasNoUpcomingTasks}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Agenda.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AgendaGroupViewModel">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding DateLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlannerTaskRowViewModel">
                                                    <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0"
                                                            Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Fill="{Binding PriorityColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding CategoryName}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Timeline -->
            <TabItem Header="Timeline">
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="No tasks with a due date yet." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               IsVisible="{Binding Timeline.HasNoTasksWithDueDates}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Timeline.Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlannerTaskRowViewModel">
                                    <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0"
                                            Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding DueDate, StringFormat='{}{0:MMM d, h:mm tt}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Width="130" VerticalAlignment="Center" />
                                            <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Fill="{Binding PriorityColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Kanban -->
            <TabItem Header="Kanban">
                <Grid ColumnDefinitions="*,*" Margin="0,8,0,0" ColumnSpacing="12">
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="To Do" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Kanban.ToDoCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KanbanCardViewModel">
                                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Padding="8" Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Fill="{Binding PriorityColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                                <Button Content="{Binding MoveButtonLabel}" Command="{Binding MoveCommand}"
                                                        FontSize="10" Padding="6,3" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Done" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Kanban.DoneCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KanbanCardViewModel">
                                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Padding="8" Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Fill="{Binding PriorityColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextDecorations="Strikethrough" />
                                                </Grid>
                                                <Button Content="{Binding MoveButtonLabel}" Command="{Binding MoveCommand}"
                                                        FontSize="10" Padding="6,3" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Matrix -->
            <TabItem Header="Matrix">
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*" Margin="0,8,0,0" RowSpacing="8" ColumnSpacing="8">
                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource QuadrantRedBackgroundBrush}" BorderBrush="{DynamicResource QuadrantRedBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Matrix.UrgentImportant.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matrix.UrgentImportant.Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Matrix.UrgentImportant.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlannerTaskRowViewModel">
                                            <Button Command="{Binding SelectCommand}" Content="{Binding Title}" Background="Transparent"
                                                    BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource QuadrantBlueBackgroundBrush}" BorderBrush="{DynamicResource QuadrantBlueBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Matrix.NotUrgentImportant.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matrix.NotUrgentImportant.Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Matrix.NotUrgentImportant.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlannerTaskRowViewModel">
                                            <Button Command="{Binding SelectCommand}" Content="{Binding Title}" Background="Transparent"
                                                    BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource QuadrantAmberBackgroundBrush}" BorderBrush="{DynamicResource QuadrantAmberBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Matrix.UrgentNotImportant.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matrix.UrgentNotImportant.Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Matrix.UrgentNotImportant.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlannerTaskRowViewModel">
                                            <Button Command="{Binding SelectCommand}" Content="{Binding Title}" Background="Transparent"
                                                    BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Matrix.NotUrgentNotImportant.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matrix.NotUrgentNotImportant.Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Matrix.NotUrgentNotImportant.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlannerTaskRowViewModel">
                                            <Button Command="{Binding SelectCommand}" Content="{Binding Title}" Background="Transparent"
                                                    BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Goals -->
            <TabItem Header="Goals">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding Goals.NewGoalName}" PlaceholderText="New goal name…" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding Goals.AddGoalCommand}" Padding="12,6" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="No goals yet — add one above to start a streak." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               IsVisible="{Binding Goals.HasNoGoals}" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Goals.Goals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GoalRowViewModel">
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding CurrentStreak}" /><Run Text=" day streak · " /><Run Text="{Binding TotalCompletions}" /><Run Text=" total" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ToggleButtonLabel}" Command="{Binding ToggleTodayCommand}"
                                                    FontSize="11" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}"
                                                    FontSize="11" Padding="8,4" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Milestones -->
            <TabItem Header="Milestones">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding Milestones.NewMilestoneTitle}" PlaceholderText="New milestone title…" Margin="0,0,8,0" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding Milestones.NewMilestoneTargetDate}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Add" Command="{Binding Milestones.AddMilestoneCommand}" Padding="12,6" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="No milestones yet — add one above." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               IsVisible="{Binding Milestones.HasNoMilestones}" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Milestones.Milestones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MilestoneRowViewModel">
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextDecorations="{Binding IsCompleted, Converter={x:Static conv:BoolToTextDecorationsConverter.Instance}}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding TargetDateDisplay}" /><Run Text=" · " /><Run Text="{Binding ProgressDisplay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ToggleButtonLabel}" Command="{Binding ToggleCompleteCommand}"
                                                    FontSize="11" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}"
                                                    FontSize="11" Padding="8,4" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Projects -->
            <TabItem Header="Projects">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding Projects.NewProjectName}" PlaceholderText="New project name…" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding Projects.AddProjectCommand}" Padding="12,6" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="No projects yet — add one above." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               IsVisible="{Binding Projects.HasNoProjects}" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Projects.Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectRowViewModel">
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding ColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Opacity="{Binding IsArchived, Converter={x:Static conv:BoolToArchivedOpacityConverter.Instance}}" />
                                                <TextBlock Text="{Binding ProgressDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding ToggleButtonLabel}" Command="{Binding ToggleArchivedCommand}"
                                                    FontSize="11" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Delete" Command="{Binding DeleteCommand}"
                                                    FontSize="11" Padding="8,4" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
