<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="560"
        x:Class="DeskTodo.App.Views.KeyboardShortcutsWindow"
        x:DataType="vm:KeyboardShortcutsViewModel"
        Title="Keyboard Shortcuts"
        Width="440" Height="560"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="OnWindowKeyDown">

    <!-- Roadmap-39-100.md's Feature 77 — display defaults, edit, detect conflicts, restore default, export/import. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Shortcuts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyboardShortcutOption">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding EffectiveCombo}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="Conflict — another shortcut uses this same combo" FontSize="11"
                                               Foreground="{DynamicResource DangerTextBrush}" IsVisible="{Binding HasConflict}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Edit"
                                        Command="{Binding $parent[ItemsControl].((vm:KeyboardShortcutsViewModel)DataContext).BeginCaptureCommand}"
                                        CommandParameter="{Binding CommandId}" FontSize="11" Padding="8,3" Margin="0,0,6,0" />
                                <Button Grid.Column="2" Content="Reset" IsVisible="{Binding IsCustomized}"
                                        Command="{Binding $parent[ItemsControl].((vm:KeyboardShortcutsViewModel)DataContext).ResetToDefaultCommand}"
                                        CommandParameter="{Binding CommandId}" FontSize="11" Padding="8,3" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Press a key combination now…" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   IsVisible="{Binding CapturingCommandId, Converter={x:Static convCore:StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="3" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export" Command="{Binding ExportCommand}" Padding="10,4" FontSize="11" />
                <Button Content="Import" Command="{Binding ImportCommand}" Padding="10,4" FontSize="11" />
            </StackPanel>
            <TextBox Text="{Binding ExportImportText}" AcceptsReturn="True" Height="80" FontSize="11" FontFamily="monospace" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static convCore:StringConverters.IsNotNullOrEmpty}}" />
            <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Padding="16,8" />
        </StackPanel>
    </Grid>

</Window>
