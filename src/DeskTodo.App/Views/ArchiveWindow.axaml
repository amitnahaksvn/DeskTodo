<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="560"
        x:Class="DeskTodo.App.Views.ArchiveWindow"
        x:DataType="vm:ArchiveViewModel"
        Title="Archive Vault"
        Width="440" Height="560"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Roadmap-39-100.md's Feature 45 — keep permanently, out of normal views. Not Trash: nothing here is headed for deletion. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Archive Vault" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <TextBox Grid.Row="1" PlaceholderText="Search archived items…" Text="{Binding SearchText}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Tasks" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchivedTaskOption">
                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Restore"
                                                Command="{Binding $parent[ItemsControl].((vm:ArchiveViewModel)DataContext).RestoreTaskCommand}"
                                                CommandParameter="{Binding Id}" FontSize="11" Padding="8,3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No archived tasks" IsVisible="{Binding !Tasks.Count}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Projects" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchivedProjectOption">
                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Restore"
                                                Command="{Binding $parent[ItemsControl].((vm:ArchiveViewModel)DataContext).RestoreProjectCommand}"
                                                CommandParameter="{Binding Id}" FontSize="11" Padding="8,3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No archived projects" IsVisible="{Binding !Projects.Count}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" />
    </Grid>

</Window>
