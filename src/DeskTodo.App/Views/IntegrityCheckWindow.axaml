<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:abstractions="using:DeskTodo.Application.Abstractions"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="480"
        x:Class="DeskTodo.App.Views.IntegrityCheckWindow"
        x:DataType="vm:IntegrityCheckViewModel"
        Title="Data Integrity Check"
        Width="440" Height="480"
        MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Roadmap-39-100.md's Feature 70 — scans for dangling references, missing attachment files and SQLite-level corruption; auto-repairs only the unambiguously safe subset. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Data Integrity Check" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Run Check" Command="{Binding RunCheckCommand}"
                    IsEnabled="{Binding !IsBusy}" FontSize="11" Padding="8,4" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                        IsVisible="{Binding StatusMessage, Converter={x:Static convCore:StringConverters.IsNotNullOrEmpty}}"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Fix All Safe Issues" Command="{Binding RepairAllCommand}"
                    IsVisible="{Binding HasAutoRepairableIssues}" IsEnabled="{Binding !IsBusy}" FontSize="11" Padding="8,4" />
        </Grid>

        <Panel Grid.Row="2">
            <ScrollViewer IsVisible="{Binding Issues.Count}">
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="abstractions:IntegrityIssue">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Auto-fixable" FontSize="10" IsVisible="{Binding IsAutoRepairable}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Run a check to see results" IsVisible="{Binding !Issues.Count}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
        </Panel>

        <Button Grid.Row="3" Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" />
    </Grid>

</Window>
