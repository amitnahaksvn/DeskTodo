<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="520"
        x:Class="DeskTodo.App.Views.WorkSessionHistoryWindow"
        x:DataType="vm:WorkSessionHistoryViewModel"
        Title="Work Session History"
        Width="420" Height="520"
        MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Roadmap-39-100.md's Feature 65 — a reporting layer over the existing FocusSession log (Phase 23), not a parallel entity. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Work Session History" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,12">
            <Border Grid.Column="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="Today" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TodayTotalDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="This week" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ThisWeekTotalDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Panel Grid.Row="2">
            <ScrollViewer IsVisible="{Binding Sessions.Count}">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkSessionOption">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding TaskTitle}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="{Binding TypeDisplay}" /><Run Text=" · " /><Run Text="{Binding StartedAtDisplay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding DurationMinutes}" /><Run Text="m" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No sessions logged yet" IsVisible="{Binding !Sessions.Count}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
        </Panel>

        <Button Grid.Row="3" Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" />
    </Grid>

</Window>
