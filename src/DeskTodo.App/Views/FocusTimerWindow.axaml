<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="420"
        x:Class="DeskTodo.App.Views.FocusTimerWindow"
        x:DataType="vm:FocusTimerViewModel"
        Title="Focus Timer"
        Width="320" Height="420"
        MinWidth="320" MinHeight="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <!--
      Phase 23's session timer — one window for Pomodoro/Stopwatch/Countdown Timer (the
      latter covering "Focus Timer"/"Focus Mode"/"Deep Work Session" from the original
      wishlist, see FocusSessionType's doc comment). Bound to the DI-singleton
      FocusTimerViewModel, the same instance the widget header's indicator binds to — so a
      session started here keeps running/ticking even after this window is closed.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Focus Timer" FontSize="16" FontWeight="SemiBold"
                   Foreground="#1E293B" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="Type" FontSize="12" Foreground="#64748B" />
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                      IsEnabled="{Binding !IsRunning}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="Task (optional)" FontSize="12" Foreground="#64748B" />
            <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                      IsEnabled="{Binding !IsRunning}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskOption">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,10" IsVisible="{Binding IsCountdownType}">
            <TextBlock Text="Duration (minutes)" FontSize="12" Foreground="#64748B" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                <NumericUpDown Grid.Column="0" Value="{Binding SelectedDurationMinutes}"
                               Minimum="1" Increment="5" IsEnabled="{Binding !IsRunning}" />
                <Button Grid.Column="1" Content="25" Command="{Binding SelectDurationPresetCommand}" CommandParameter="25"
                        IsEnabled="{Binding !IsRunning}" Padding="8,4" FontSize="11" />
                <Button Grid.Column="2" Content="50" Command="{Binding SelectDurationPresetCommand}" CommandParameter="50"
                        IsEnabled="{Binding !IsRunning}" Padding="8,4" FontSize="11" />
                <Button Grid.Column="3" Content="90" Command="{Binding SelectDurationPresetCommand}" CommandParameter="90"
                        IsEnabled="{Binding !IsRunning}" Padding="8,4" FontSize="11" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding DisplayText}" FontSize="48" FontWeight="Bold"
                       Foreground="#1E293B" HorizontalAlignment="Center" FontFamily="monospace" />
            <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#94A3B8"
                       IsVisible="{Binding IsPomodoroType}">
                <Run Text="Round" /><Run Text=" " /><Run Text="{Binding RoundNumber}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,0">
            <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}"
                    Padding="20,10" Background="#3B82F6" Foreground="White" />
            <Button Content="Pause" Command="{Binding PauseCommand}"
                    IsVisible="{Binding CanPause}" Padding="20,10" />
            <Button Content="Resume" Command="{Binding ResumeCommand}"
                    IsVisible="{Binding CanResume}" Padding="20,10" />
            <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"
                    Padding="20,10" Background="#FEE2E2" Foreground="#DC2626" />
        </StackPanel>
    </Grid>

</Window>
