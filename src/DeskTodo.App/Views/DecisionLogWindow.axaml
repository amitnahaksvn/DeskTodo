<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="620"
        x:Class="DeskTodo.App.Views.DecisionLogWindow"
        x:DataType="vm:DecisionLogViewModel"
        Title="Decision Log"
        Width="460" Height="620"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Roadmap-39-100.md's Feature 57 — important decisions recorded independently from ordinary tasks. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Decision Log" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <TextBox Grid.Row="1" PlaceholderText="Search decisions…" Text="{Binding SearchText}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="10">
                <Expander Header="Record a new decision">
                    <StackPanel Spacing="6" Margin="0,8,0,0">
                        <TextBox PlaceholderText="Decision title (e.g. Use PostgreSQL instead of MongoDB)" Text="{Binding NewTitle}" />
                        <TextBox PlaceholderText="Context / situation" Text="{Binding NewContext}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
                        <TextBox PlaceholderText="What was decided" Text="{Binding NewDecisionText}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
                        <TextBox PlaceholderText="Alternatives considered" Text="{Binding NewAlternatives}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
                        <TextBox PlaceholderText="Reason" Text="{Binding NewReason}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
                        <Button Content="Record Decision" Command="{Binding RecordCommand}" HorizontalAlignment="Right" Padding="12,6" />
                    </StackPanel>
                </Expander>

                <ItemsControl ItemsSource="{Binding Decisions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DecisionOption">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Delete" Command="{Binding $parent[ItemsControl].((vm:DecisionLogViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding Id}" FontSize="11" Padding="6,2"
                                                Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DecisionText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Reason, StringFormat='Reason: {0}'}"
                                               IsVisible="{Binding Reason, Converter={x:Static convCore:StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No decisions recorded yet" IsVisible="{Binding !Decisions.Count}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" />
    </Grid>

</Window>
