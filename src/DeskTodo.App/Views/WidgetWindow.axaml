<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:conv="using:DeskTodo.App.Converters"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="560"
        x:Class="DeskTodo.App.Views.WidgetWindow"
        x:DataType="vm:WidgetViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DeskTodo"
        Width="340" Height="560"
        MinWidth="280" MinHeight="360"
        CanResize="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="{Binding ShowInTaskbar}">

    <!--
      No Design.DataContext here: WidgetViewModel now takes DI dependencies
      (ITaskService, ICategoryRepository, ISettingsService, loggers), so it
      can't be constructed inline by the XAML previewer. App.axaml.cs
      supplies a DesignTime*-backed instance instead when App.Services is
      null.

      Desktop-level attachment (sitting behind icons, above wallpaper) and
      click-through view mode are later phases (Platform integration).

      Search/filter and multi-select are collapsed by default (toggled via
      the header's icon buttons) rather than permanently visible, to keep
      the default view small and uncluttered.
    -->
    <Border Background="{Binding WidgetBackgroundHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
            CornerRadius="16" ClipToBounds="True" BoxShadow="0 8 32 0 #33000000">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Background="Transparent"
                  Margin="20,16,12,4" PointerPressed="OnHeaderPointerPressed">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding DayOfWeekText}" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding DateText}" FontSize="13" Foreground="#64748B" />
                </StackPanel>
                <Button Grid.Column="1" Content="&#x1F50D;" Command="{Binding ToggleSearchBarCommand}"
                        Background="Transparent" BorderThickness="0" Padding="6" FontSize="13"
                        Foreground="#94A3B8" VerticalAlignment="Top" Cursor="Hand" ToolTip.Tip="Search &amp; filter" />
                <Button Grid.Column="2" Content="&#x2611;" Command="{Binding ToggleSelectModeCommand}"
                        Background="Transparent" BorderThickness="0" Padding="6" FontSize="13"
                        Foreground="#94A3B8" VerticalAlignment="Top" Cursor="Hand" ToolTip.Tip="Select multiple" />
                <Button Grid.Column="3" Content="&#x2699;" Command="{Binding OpenSettingsCommand}"
                        Background="Transparent" BorderThickness="0" Padding="6" FontSize="13"
                        Foreground="#94A3B8" VerticalAlignment="Top" Cursor="Hand" ToolTip.Tip="Settings" />
                <Button Grid.Column="4" Content="&#x2715;" Click="OnCloseButtonClick"
                        Background="Transparent" BorderThickness="0" Padding="6" FontSize="11"
                        Foreground="#94A3B8" VerticalAlignment="Top" Cursor="Hand" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,0,20,4">
                <Button Grid.Column="0" Content="&#x2039;" Command="{Binding GoToPreviousDayCommand}"
                        Padding="10,4" FontSize="16" ToolTip.Tip="Previous day" />
                <Button Grid.Column="1" Content="Today" Command="{Binding GoToTodayCommand}"
                        IsEnabled="{Binding IsToday, Converter={x:Static convCore:BoolConverters.Not}}"
                        Margin="4,0" Padding="10,4" FontSize="12" />
                <Button Grid.Column="2" Content="&#x203A;" Command="{Binding GoToNextDayCommand}"
                        Padding="10,4" FontSize="16" ToolTip.Tip="Next day" />
                <CalendarDatePicker Grid.Column="4" SelectedDate="{Binding SelectedDate}"
                                     Width="130" ToolTip.Tip="Jump to a date" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="20,0,20,8" Spacing="6" IsVisible="{Binding IsSearchBarVisible}">
                <TextBox Text="{Binding SearchText}" PlaceholderText="Search title, notes, description…" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="Filter by status" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="Sort by" />
                </Grid>
                <!--
                  Category names are user-defined and can be longer than "Active"/"Manual",
                  so this gets the full row width rather than squeezing into a third column
                  alongside Status/Sort.
                -->
                <ComboBox x:Name="CategoryFilterComboBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}"
                          HorizontalAlignment="Stretch" ToolTip.Tip="Filter by category" />
            </StackPanel>

            <Panel Grid.Row="3" Margin="20,4,20,8">
                <TextBox IsVisible="{Binding IsSelectMode, Converter={x:Static convCore:BoolConverters.Not}}"
                         PlaceholderText="Add a task…" Text="{Binding NewTaskTitle}" KeyDown="OnAddTaskKeyDown" />
                <Grid IsVisible="{Binding IsSelectMode}" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#64748B">
                        <Run Text="{Binding SelectedCount}" /><Run Text=" selected" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="Select All" Command="{Binding SelectAllVisibleCommand}"
                            FontSize="11" Padding="8,4" />
                    <Button Grid.Column="2" Content="Complete" Command="{Binding BulkCompleteCommand}"
                            IsEnabled="{Binding HasSelection}" FontSize="11" Padding="8,4" />
                    <Button Grid.Column="3" Content="Delete" Command="{Binding BulkDeleteCommand}"
                            IsEnabled="{Binding HasSelection}" FontSize="11" Padding="8,4"
                            Background="#FEE2E2" Foreground="#DC2626" />
                </Grid>
            </Panel>

            <Panel Grid.Row="4" Margin="8,0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding VisibleTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskItemViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="6,7"
                                      DragDrop.AllowDrop="True" DragDrop.DragOver="OnRowDragOver" DragDrop.Drop="OnRowDrop">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" Command="{Binding OpenEditorCommand}" />
                                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                                            <MenuItem Header="Pin / Unpin" Command="{Binding TogglePinCommand}" />
                                            <Separator />
                                            <MenuItem Header="Archive" Command="{Binding ArchiveCommand}" />
                                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <TextBlock Grid.Column="0" Text="&#x283F;" FontSize="14" Margin="0,0,6,0"
                                               VerticalAlignment="Center" Foreground="#CBD5E1" Cursor="SizeAll"
                                               IsVisible="{Binding IsSelectModeActive, Converter={x:Static convCore:BoolConverters.Not}}"
                                               PointerPressed="OnDragHandlePointerPressed"
                                               ToolTip.Tip="Drag to reorder" />
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              IsVisible="{Binding IsSelectModeActive}"
                                              VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              Command="{Binding ToggleCompleteCommand}"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                             Fill="{Binding PriorityColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />

                                    <TextBlock Grid.Column="3" Text="{Binding Title}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="#1E293B"
                                               IsVisible="{Binding IsEditing, Converter={x:Static convCore:BoolConverters.Not}}"
                                               DoubleTapped="OnTitleDoubleTapped"
                                               TextDecorations="{Binding IsCompleted, Converter={x:Static conv:BoolToTextDecorationsConverter.Instance}}" />
                                    <TextBox Grid.Column="3" Text="{Binding EditingTitle}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsEditing}" KeyDown="OnEditTitleKeyDown" />

                                    <TextBlock Grid.Column="4" Text="&#x1F4CC;" FontSize="10" Margin="6,0,0,0"
                                               VerticalAlignment="Center" IsVisible="{Binding IsPinned}"
                                               ToolTip.Tip="Pinned" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding EmptyStateText}" IsVisible="{Binding HasNoTasks}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#94A3B8" FontSize="13" />
            </Panel>

            <StackPanel Grid.Row="5" Margin="20,8,20,18" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ProgressSummaryText}" FontSize="12" Foreground="#64748B" />
                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B">
                        <Run Text="{Binding ProgressPercentage}" /><Run Text="%" />
                    </TextBlock>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}"
                             Height="6" CornerRadius="3" />
            </StackPanel>

        </Grid>
    </Border>

</Window>
