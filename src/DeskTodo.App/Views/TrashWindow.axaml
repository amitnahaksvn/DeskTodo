<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="480"
        x:Class="DeskTodo.App.Views.TrashWindow"
        x:DataType="vm:TrashViewModel"
        Title="Trash"
        Width="400" Height="480"
        MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!--
      Roadmap-39-100.md's Feature 46 — every soft-deleted task
      (TaskItem.IsDeleted, existing since Phase 8), recoverable here or permanently removed.
      No auto-purge retention in this pass — Restore/Delete Permanently/Empty Trash are all
      manual, explicit actions.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Trash" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Empty Trash" Click="OnEmptyTrashClick"
                    IsEnabled="{Binding DeletedTasks.Count}" FontSize="11" Padding="8,4"
                    Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" />
        </Grid>

        <Panel Grid.Row="1">
            <ScrollViewer IsVisible="{Binding DeletedTasks.Count}">
                <ItemsControl ItemsSource="{Binding DeletedTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrashedTaskOption">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DeletedAtDisplay, StringFormat='Deleted {0}'}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Restore"
                                            Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreCommand}"
                                            CommandParameter="{Binding Id}" FontSize="11" Padding="8,3" Margin="6,0,0,0" />
                                    <Button Grid.Column="2" Content="Delete Forever" Click="OnDeleteForeverClick"
                                            Tag="{Binding}" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                            Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Trash is empty" IsVisible="{Binding !DeletedTasks.Count}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
        </Panel>

        <Button Grid.Row="2" Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" />
    </Grid>

</Window>
