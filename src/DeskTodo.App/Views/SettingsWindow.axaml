<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:conv="using:DeskTodo.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="640"
        x:Class="DeskTodo.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="320" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,16" Foreground="#1E293B" />

        <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="18" Margin="0,0,12,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Accent color" FontSize="12" Foreground="#64748B" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Background="#3B82F6" Command="{Binding SelectAccentColorCommand}" CommandParameter="#3B82F6" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#8B5CF6" Command="{Binding SelectAccentColorCommand}" CommandParameter="#8B5CF6" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#10B981" Command="{Binding SelectAccentColorCommand}" CommandParameter="#10B981" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#EC4899" Command="{Binding SelectAccentColorCommand}" CommandParameter="#EC4899" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#F97316" Command="{Binding SelectAccentColorCommand}" CommandParameter="#F97316" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#14B8A6" Command="{Binding SelectAccentColorCommand}" CommandParameter="#14B8A6" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Border Width="28" Height="28" CornerRadius="14" Margin="8,0,0,0"
                            Background="{Binding AccentColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                            BorderBrush="#CBD5E1" BorderThickness="1" ToolTip.Tip="Currently selected" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Widget opacity" FontSize="12" Foreground="#64748B" />
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B">
                        <Run Text="{Binding OpacityPercent}" /><Run Text="%" />
                    </TextBlock>
                </Grid>
                <Slider Minimum="40" Maximum="100" Value="{Binding OpacityPercent}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Window position" FontSize="12" Foreground="#64748B" />
                <Button Content="Reset to default position &amp; size" Command="{Binding ResetWindowPositionCommand}"
                        ToolTip.Tip="Takes effect the next time DeskTodo opens" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Monitor" FontSize="12" Foreground="#64748B" />
                <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                          HorizontalAlignment="Stretch" ToolTip.Tip="Which monitor the widget opens on">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonitorOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Notifications" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Overdue-task alerts and a daily summary" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Notification sound" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Play a sound with overdue/summary/wellness notifications" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationSoundEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Start at login" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Open DeskTodo automatically when you log in" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show in Dock / Taskbar" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Turn off to hide DeskTodo from the Dock/taskbar and app-switcher" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowInTaskbar}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Auto-reschedule overdue tasks" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Move incomplete tasks left on past days onto today" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRescheduleOverdueTasks}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="Focus Timer — Pomodoro lengths (minutes)" FontSize="12" Foreground="#64748B" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Work" FontSize="11" Foreground="#94A3B8" />
                        <NumericUpDown Value="{Binding PomodoroWorkMinutes}" Minimum="1" Increment="5" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Break" FontSize="11" Foreground="#94A3B8" />
                        <NumericUpDown Value="{Binding PomodoroBreakMinutes}" Minimum="1" Increment="1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Wellness reminders" FontSize="12" Foreground="#64748B" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Break Reminder" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding BreakReminderEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding BreakReminderEnabled}">
                    <TextBlock Grid.Column="0" Text="Every (minutes)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding BreakReminderIntervalMinutes}" Minimum="5" Increment="5" Width="120" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="Water Reminder" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaterReminderEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding WaterReminderEnabled}">
                    <TextBlock Grid.Column="0" Text="Every (minutes)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding WaterReminderIntervalMinutes}" Minimum="5" Increment="5" Width="120" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="Stretch Reminder" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StretchReminderEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding StretchReminderEnabled}">
                    <TextBlock Grid.Column="0" Text="Every (minutes)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding StretchReminderIntervalMinutes}" Minimum="5" Increment="5" Width="120" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="App Lock" FontSize="12" Foreground="#64748B" />
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Require a PIN to open DeskTodo" FontSize="13" Foreground="#1E293B" />
                        <TextBlock Text="{Binding HasPinSet, Converter={x:Static conv:PinStatusTextConverter.Instance}}"
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding PinLockEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Spacing="6" IsVisible="{Binding PinLockEnabled}" Margin="0,4,0,0">
                    <TextBox Text="{Binding NewPin}" PasswordChar="•" PlaceholderText="{Binding HasPinSet, Converter={x:Static conv:PinFieldWatermarkConverter.Instance}}" />
                    <TextBox Text="{Binding ConfirmPin}" PasswordChar="•" PlaceholderText="Confirm PIN" />
                    <TextBlock Text="{Binding PinErrorMessage}" FontSize="11" Foreground="#DC2626"
                               IsVisible="{Binding PinErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Data" FontSize="12" Foreground="#64748B" />
                <Button Content="Import / Export tasks…" Click="OnImportExportClick" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,8" />
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,8"
                    Background="#3B82F6" Foreground="White" />
        </StackPanel>
    </Grid>

</Window>
