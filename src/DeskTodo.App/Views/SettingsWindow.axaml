<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:conv="using:DeskTodo.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="640"
        x:Class="DeskTodo.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="320" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,16" Foreground="#1E293B" />

        <StackPanel Grid.Row="1" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Accent color" FontSize="12" Foreground="#64748B" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Background="#3B82F6" Command="{Binding SelectAccentColorCommand}" CommandParameter="#3B82F6" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#8B5CF6" Command="{Binding SelectAccentColorCommand}" CommandParameter="#8B5CF6" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#10B981" Command="{Binding SelectAccentColorCommand}" CommandParameter="#10B981" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#EC4899" Command="{Binding SelectAccentColorCommand}" CommandParameter="#EC4899" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#F97316" Command="{Binding SelectAccentColorCommand}" CommandParameter="#F97316" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Button Background="#14B8A6" Command="{Binding SelectAccentColorCommand}" CommandParameter="#14B8A6" Width="28" Height="28" CornerRadius="14" Padding="0" />
                    <Border Width="28" Height="28" CornerRadius="14" Margin="8,0,0,0"
                            Background="{Binding AccentColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                            BorderBrush="#CBD5E1" BorderThickness="1" ToolTip.Tip="Currently selected" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Widget opacity" FontSize="12" Foreground="#64748B" />
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B">
                        <Run Text="{Binding OpacityPercent}" /><Run Text="%" />
                    </TextBlock>
                </Grid>
                <Slider Minimum="40" Maximum="100" Value="{Binding OpacityPercent}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Window position" FontSize="12" Foreground="#64748B" />
                <Button Content="Reset to default position &amp; size" Command="{Binding ResetWindowPositionCommand}"
                        ToolTip.Tip="Takes effect the next time DeskTodo opens" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Notifications" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Overdue-task alerts and a daily summary" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Start at login" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Open DeskTodo automatically when you log in" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show in Dock / Taskbar" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Turn off to hide DeskTodo from the Dock/taskbar and app-switcher" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowInTaskbar}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Auto-reschedule overdue tasks" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Move incomplete tasks left on past days onto today" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRescheduleOverdueTasks}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="Data" FontSize="12" Foreground="#64748B" />
                <Button Content="Import / Export tasks…" Click="OnImportExportClick" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,8" />
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,8"
                    Background="#3B82F6" Foreground="White" />
        </StackPanel>
    </Grid>

</Window>
