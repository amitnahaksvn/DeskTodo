<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="240"
        x:Class="DeskTodo.App.Views.QuickAddWindow"
        x:DataType="vm:QuickAddViewModel"
        Title="Quick Add"
        Width="360" Height="240"
        MinWidth="360" MinHeight="240"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Activated="OnActivated">

    <!--
      Phase 22's Quick Add — title + priority + category only, deliberately not the
      full-field editor (see QuickAddViewModel's doc comment). CenterScreen (not
      CenterOwner — this window has no owner, it's summoned from the tray independently
      of the widget) and Topmost, since the whole point of a fast-capture window is that
      it doesn't get lost behind whatever else is on screen.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Quick Add" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Spacing="2">
            <TextBox x:Name="TitleTextBox" Text="{Binding Title}"
                      PlaceholderText="What needs doing? Try &quot;tomorrow 5pm !high&quot;" FontSize="14" KeyDown="OnTitleKeyDown" />
            <!-- Feature 41 (Roadmap-39-100.md) — live preview of what the typed text parsed into. -->
            <TextBlock Text="{Binding ParsePreview}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding ParsePreview, Converter={x:Static convCore:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                <TextBlock Text="Priority" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryOption">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,8" />
            <Button Content="Add" Command="{Binding AddCommand}" Padding="16,8"
                    Background="#3B82F6" Foreground="White" />
        </StackPanel>
    </Grid>

</Window>
