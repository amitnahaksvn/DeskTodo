<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="180"
        x:Class="DeskTodo.App.Views.ConfirmDialogWindow"
        Title="Confirm"
        Width="340" Height="180"
        MinWidth="340" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height"
        Background="#F8FAFC">

    <!--
      A small, reusable Yes/No confirmation dialog — Avalonia has no built-in MessageBox
      the way WPF does, so this is the app's one shared "are you sure?" surface (currently
      used for delete confirmations). Title/message/confirm-button text are all set by the
      caller via ShowAsync rather than hardcoded, so it isn't delete-specific even though
      that's its only caller today.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" x:FieldModifier="public" FontSize="16" FontWeight="SemiBold"
                   Foreground="#1E293B" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" x:Name="MessageTextBlock" x:FieldModifier="public" FontSize="13" Foreground="#475569"
                   TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Padding="16,8" />
            <Button x:Name="ConfirmButton" x:FieldModifier="public" Content="Delete" Click="OnConfirmClick" Padding="16,8"
                    Background="#FEE2E2" Foreground="#DC2626" />
        </StackPanel>
    </Grid>

</Window>
