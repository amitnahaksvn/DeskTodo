<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskTodo.App.ViewModels"
        xmlns:convCore="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="560"
        x:Class="DeskTodo.App.Views.TaskGroupWindow"
        x:DataType="vm:TaskGroupViewModel"
        Title="Task Groups"
        Width="420" Height="560"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!--
      A named, saved bundle of existing Task Templates (Phase 17) — created once, then added
      to a chosen day's to-do list in one click, one real task per member template. Members
      are picked from the same templates "From template…" already offers, not a second
      task-shape definition.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Task Groups" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}" />

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="New group" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding NewGroupName}" PlaceholderText="Group name" />
            <TextBlock Text="Templates in this group" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding AvailableTemplates}" MaxHeight="120">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableTemplateOption">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Create Group" Command="{Binding CreateGroupCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static convCore:StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource DangerTextBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="Your groups" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding ApplyDate}" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskGroupOption">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding MemberSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Add to Day"
                                            Command="{Binding $parent[ItemsControl].((vm:TaskGroupViewModel)DataContext).ApplyGroupCommand}"
                                            CommandParameter="{Binding Id}" FontSize="11" Padding="8,3" Margin="6,0,0,0" />
                                    <Button Grid.Column="2" Content="Delete"
                                            Command="{Binding $parent[ItemsControl].((vm:TaskGroupViewModel)DataContext).DeleteGroupCommand}"
                                            CommandParameter="{Binding Id}" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                            Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Button Grid.Row="3" Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" />
    </Grid>

</Window>
