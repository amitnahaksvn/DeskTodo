<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeskTodo</AssemblyName>
    <RootNamespace>DeskTodo.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <!-- Required at the startup-project level for `dotnet ef` to work, even though the
         DbContext lives in Infrastructure — Infrastructure's own reference is
         PrivateAssets="all" so it doesn't flow transitively to this project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskTodo.Application\DeskTodo.Application.csproj" />
    <ProjectReference Include="..\DeskTodo.Domain\DeskTodo.Domain.csproj" />
    <ProjectReference Include="..\DeskTodo.Infrastructure\DeskTodo.Infrastructure.csproj" />
    <ProjectReference Include="..\DeskTodo.Platform.Windows\DeskTodo.Platform.Windows.csproj" />
    <ProjectReference Include="..\DeskTodo.Platform.Mac\DeskTodo.Platform.Mac.csproj" />
  </ItemGroup>
</Project>
